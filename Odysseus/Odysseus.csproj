<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>Odysseus</AssemblyName>
    <RootNamespace>Odysseus</RootNamespace>
    <Version>0.1.1</Version>
    <DalamudLibPath>$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>

    <!--
      Pin the output directory. The solution declares an x64 platform, so a solution build lands
      in bin/x64/<Config>/ while a bare project build lands in bin/<Config>/ — and Dalamud's
      dev-plugin entry points at exactly one of those. Without this, "dotnet build Odysseus.sln"
      appears to succeed while the game keeps loading a stale DLL from the other path, which is
      indistinguishable from a code change having no effect. (Lesson from Theseus.)
    -->
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!--
    The shipped quest-path library. Packed from a dev client (Settings > Pack for release) and
    committed, so a release build carries every path and nobody has to import anything. Optional at
    build time: without it the plugin still runs, it just starts empty until someone imports.
  -->
  <ItemGroup>
    <Content Include="Assets\paths.pak" Condition="Exists('Assets\paths.pak')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Allow the test assembly to access internal types -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Odysseus.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Dev-plugin reload race (same fix as Charon). Dalamud watches the DLL and reloads the moment it
    changes, then reads Odysseus.json alongside it. The compiler writes the DLL FIRST and
    DalamudPackager writes the manifest afterwards, so the reload can read a manifest that is
    still being written and fail with a "load error" that nothing retries.

    Touching the DLL after the manifest is written makes the DLL the LAST file to change, so the
    watcher's event always finds a complete manifest next to it. This must hook the PACKAGER's
    targets, not "Build": DalamudPackager registers on AfterTargets="Build" too and SDK targets
    run after project-defined ones.
  -->
  <Target Name="TouchAssemblyAfterPackaging"
          AfterTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <Touch Files="$(TargetPath)" />
  </Target>

</Project>
